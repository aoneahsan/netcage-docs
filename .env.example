# All three are optional and public identifiers. With no value that destination is not loaded at
# all — the site builds and works exactly the same, it simply reports nothing.
#
# In CI these come from repository Actions VARIABLES (not secrets), set on aoneahsan/netcage-docs.
# Never commit a real value here: this repository is public.
GOOGLE_ANALYTICS_ID=
AMPLITUDE_API_KEY=
CLARITY_PROJECT_ID=
